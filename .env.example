# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit actual Supabase credentials.
#
# Both values below are safe for browser code: this is the publishable/anon
# key, not a secret. It identifies the project and is bounded entirely by
# Postgres Row-Level Security (see supabase/migrations and
# docs/SUPABASE_SCHEMA_DESIGN.md) — it is not itself an authorization
# boundary. Never put a service_role key, database password, or management
# API token in a VITE_-prefixed variable; anything with that prefix is
# bundled into client-shipped JavaScript.

# Local: run `npx supabase status` and copy API_URL.
# Hosted (grocerymate-dev): from the Supabase dashboard's API settings.
VITE_SUPABASE_URL=

# Local: run `npx supabase status` and copy PUBLISHABLE_KEY (or ANON_KEY).
# Hosted: the project's publishable/anon key from the dashboard's API settings.
VITE_SUPABASE_PUBLISHABLE_KEY=
